+/// Kết quả `media.sniff`.
+#[derive(Debug, Clone, PartialEq, serde::Serialize)]
+pub struct Sniffed {
+    /// hls | audio | flv | ts | mp4 | ogg | html | playlist | http (mã lỗi HTTP) | error (mạng) | unknown
+    pub kind: String,
+    /// "mp3" | "aac" (kind = audio)
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub codec: Option<String>,
+    pub status: u16,
+    /// Địa chỉ nên mở: link gốc (giữ nguyên — link chuyển hướng có token đổi mỗi lần), hoặc địa chỉ luồng ghi trong danh sách
+    /// .pls / .m3u của đài
+    pub url: String,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub ct: Option<String>,
+    /// Tên đài (icy-name), kbps (icy-br)
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub name: Option<String>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub br: Option<u32>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub error: Option<String>,
+}
+
+impl Sniffed {
+    fn error(url: &str, e: String) -> Sniffed {
+        Sniffed { kind: "error".into(), codec: None, status: 0, url: url.into(), ct: None, name: None, br: None, error: Some(e) }
+    }
+}
+
+/// Đọc vài KB đầu của một link (theo chuyển hướng) để biết loại luồng — link kênh hay không có đuôi, không đoán theo đuôi được
+/// (xem `radio::classify`). Danh sách .pls / .m3u của đài thì đọc tiếp địa chỉ bên trong (tối đa 2 lớp). Quá 15 giây → error.
+pub async fn sniff(src: &str, hd: &Hdr) -> Sniffed {
+    let mut url = src.to_string();
+    let mut last = None;
+    for _ in 0..3 {
+        let (s, target) = match tokio::time::timeout(Duration::from_secs(15), sniff_once(&url, hd)).await {
+            Ok(r) => r,
+            Err(_) => (Sniffed::error(&url, "máy chủ không trả lời (quá 15 giây)".into()), None),
+        };
+        match target {
+            Some(t) if s.kind == "playlist" => {
+                url = t;
+                last = Some(s);
+            }
+            _ => return s,
+        }
+    }
+    last.unwrap_or_else(|| Sniffed::error(src, "danh sách lồng nhau quá sâu".into()))
+}
+
+fn header_text(resp: &reqwest::Response, k: &str) -> Option<String> {
+    let v = resp.headers().get(k)?;
+    let s = crate::radio::text(v.as_bytes()).trim().to_string();
+    (!s.is_empty()).then_some(s)
+}
+
+/// icy-br: «128», «128000», «128,128»
+fn icy_br(resp: &reqwest::Response) -> Option<u32> {
+    let b: u32 = header_text(resp, "icy-br")?.split(',').next()?.trim().parse().ok()?;
+    Some(if b >= 1000 { b / 1000 } else { b })
+}
+
+async fn sniff_once(url: &str, hd: &Hdr) -> (Sniffed, Option<String>) {
+    let mut rb = crate::http::client().get(url).header("Accept", "*/*").timeout(Duration::from_secs(20));
+    if let Some(r) = &hd.referer {
+        rb = rb.header("Referer", r);
+    }
+    if let Some(u) = &hd.ua {
+        rb = rb.header("User-Agent", u);
+    }
+    if let Some(o) = &hd.origin {
+        rb = rb.header("Origin", o);
+    }
+    let mut resp = match rb.send().await {
+        Ok(r) => r,
+        Err(e) => return (Sniffed::error(url, e.to_string()), None),
+    };
+    let status = resp.status().as_u16();
+    let final_url = resp.url().clone();
+    let ct = header_text(&resp, "content-type");
+    let (name, br) = (header_text(&resp, "icy-name"), icy_br(&resp));
+    let mut head = Vec::new();
+    while head.len() < 4096 {
+        match chunk(&mut resp).await {
+            Ok(Some(c)) => head.extend_from_slice(&c),
+            _ => break,
+        }
+    }
+    drop(resp);
+    let (kind, codec) = if status >= 400 { ("http", None) } else { crate::radio::classify(&head, ct.as_deref()) };
+    let target = if kind == "playlist" {
+        crate::radio::playlist_target(&crate::http::text(&head, ct.as_deref()), Some(&final_url))
+    } else {
+        None
+    };
+    crate::log::d("media", &format!("nhận dạng luồng: {kind}{} (HTTP {status}, {}): {}", codec.map(|c| format!(" {c}")).unwrap_or_default(),
+        ct.as_deref().unwrap_or("không ghi loại"), short(url)));
+    (Sniffed { kind: kind.into(), codec: codec.map(Into::into), status, url: url.to_string(), ct, name, br, error: None }, target)
+}
+
+/// Tải luồng của đài, xin kèm tên bài (`Icy-MetaData: 1`); lỗi kết nối / 5xx thì thử lại.
+async fn fetch_radio(url: &str, hd: &Hdr) -> Result<reqwest::Response, String> {
+    let mut last = String::new();
+    for attempt in 0..3u32 {
+        if attempt > 0 {
+            tokio::time::sleep(Duration::from_millis(500 << attempt)).await;
+        }
+        let mut rb = crate::http::client()
+            .get(url)
+            .header("Accept", "*/*")
+            .header("Icy-MetaData", "1")
+            .timeout(Duration::from_secs(6 * 3600));
+        if let Some(r) = &hd.referer {
+            rb = rb.header("Referer", r);
+        }
+        if let Some(u) = &hd.ua {
+            rb = rb.header("User-Agent", u);
+        }
+        if let Some(o) = &hd.origin {
+            rb = rb.header("Origin", o);
+        }
+        match rb.send().await {
+            Ok(resp) if resp.status().is_server_error() || resp.status().as_u16() == 429 => last = format!("HTTP {}", resp.status().as_u16()),
+            Ok(resp) => return Ok(resp),
+            Err(e) => last = e.to_string(),
+        }
+    }
+    Err(last)
+}
+
+/// r/<n>.mp3: luồng tiếng của đài (đã bỏ khối ICY), giữ tên bài vào `info`. Đài ngắt thì đóng kết nối — trình phát báo hết
+/// luồng, app mở lại.
+async fn radio_stream<W: AsyncWrite + Unpin>(url: &str, hd: &Hdr, info: &crate::radio::Info, w: &mut W, head_only: bool) -> bool {
+    let mut resp = match fetch_radio(url, hd).await {
+        Ok(r) => r,
+        Err(e) => {
+            crate::log::d("media", &format!("đài radio lỗi ({e}): {}", short(url)));
+            return reply(w, 502, "text/plain", b"", head_only).await;
+        }
+    };
+    let code = resp.status().as_u16();
+    if code >= 400 {
+        crate::log::d("media", &format!("đài radio HTTP {code}: {}", short(url)));
+        return reply(w, 502, "text/plain", b"", head_only).await;
+    }
+    let metaint: usize = header_text(&resp, "icy-metaint").and_then(|v| v.parse().ok()).unwrap_or(0);
+    let ct = header_text(&resp, "content-type").map(|c| c.to_ascii_lowercase()).filter(|c| c.starts_with("audio/"));
+    let codec = ct.as_deref().map(|c| if c.contains("aac") { "aac" } else { "mp3" });
+    info.set_station(header_text(&resp, "icy-name"), icy_br(&resp), codec);
+    let ct = ct.unwrap_or_else(|| if info.get().codec.as_deref() == Some("aac") { "audio/aac".into() } else { "audio/mpeg".into() });
+    crate::log::d("media", &format!("đài radio: {ct}, metaint {metaint}{}: {}", if head_only { " (HEAD)" } else { "" }, short(url)));
+    if write_head(w, 200, &[("Content-Type", ct), ("Cache-Control", "no-cache".to_string())], false).await.is_err() {
+        return false;
+    }
+    if head_only {
+        let _ = w.flush().await;
+        return false;
+    }
+    let mut strip = crate::radio::IcyStrip::new(metaint);
+    let mut out = Vec::with_capacity(32 * 1024);
+    loop {
+        match chunk(&mut resp).await {
+            Ok(Some(c)) => {
+                out.clear();
+                if let Some(t) = strip.feed(&c, &mut out) {
+                    if t != info.get().title {
+                        crate::log::d("media", &format!("đài radio: đang phát «{}»", t.as_deref().unwrap_or("")));
+                    }
+                    info.set_title(t);
+                }
+                if !out.is_empty() && (w.write_all(&out).await.is_err() || w.flush().await.is_err()) {
+                    return false;
+                }
+            }
+            Ok(None) => {
+                crate::log::d("media", &format!("đài radio ngắt luồng: {}", short(url)));
+                break;
+            }
+            Err(e) => {
+                crate::log::d("media", &format!("đài radio đứt ({e}): {}", short(url)));
+                break;
+            }
+        }
+    }
+    false
 }
 
