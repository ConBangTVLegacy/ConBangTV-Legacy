+// ---- Đài radio (luồng MP3 / AAC liền của Icecast / Shoutcast) ----
+
+/// Mở phiên phát một đài: địa chỉ `r/<n>.mp3|aac`. Mỗi lần trình phát mở địa chỉ đó là một kết nối tới đài (xin kèm tên bài
+/// hát), trả luồng tiếng liền — không độ dài, không Range, như chính Icecast — đã bỏ khối ICY. `codec` theo `media.sniff`.
+pub fn open_radio(src: &str, hd: Hdr, codec: Option<&str>) -> Option<Opened> {
+    let u = url::Url::parse(src).ok()?;
+    if u.scheme() != "http" && u.scheme() != "https" {
+        return None;
+    }
+    let port = start();
+    let token = format!("{:032x}", rand::random::<u128>());
+    let ext = if codec == Some("aac") { "aac" } else { "mp3" };
+    let mut links = Links::default();
+    let id = links.id(src);
+    let url = format!("http://127.0.0.1:{port}/{token}/r/{id}.{ext}");
+    let info = Arc::new(crate::radio::Info::new(ext));
+    add_session(Session { token: token.clone(), hd, inline: Vec::new(), links, live: None, radio: Some(info) });
+    Some(Opened { url, subtitle: None, token })
+}
+
+/// Tên đài / bài đang phát của phiên radio (None = không có phiên đó hoặc không phải radio).
+pub fn radio_info(token: &str) -> Option<crate::radio::InfoData> {
+    let ss = SESSIONS.lock().unwrap();
+    ss.iter().find(|s| s.token == token).and_then(|s| s.radio.as_ref().map(|r| r.get()))
+}
