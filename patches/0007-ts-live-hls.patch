new file mode 100644
index 0000000..b1d10cb
--- /dev/null
+++ b/linux/core/src/ts_hls.rs
@@ -0,0 +1,723 @@
+//! Luồng MPEG-TS liền (IPTV kiểu Xtream «http://máy-chủ/tên/mật-khẩu/123», link «.ts») → HLS trực tiếp cho AVPlayer của iOS cũ
+//! (chỉ phát HLS). Luồng đã là MPEG-TS nên không đổi vỏ: đọc từng gói 188 byte, tìm PAT / PMT, cắt đoạn ~2 s tại khung khoá của
+//! hình (gói mở đầu PES có cờ random_access, hoặc có NAL IDR / SPS), mỗi đoạn mở đầu bằng PAT + PMT mới nhất (bộ đếm liên tục
+//! riêng); bỏ các bảng phụ (SDT, EIT…). Đoạn giữ trong `flv_hls::Live` như luồng FLV. Mã hình máy cũ không giải mã được (H.265,
+//! MPEG-2) → báo lỗi rõ. Tiếng MPEG-1 / 2 Layer I / II (MP2 — hay gặp ở IPTV châu Âu): AVPlayer iOS 5 / 6 không giải mã, và kênh
+//! tiếng hỏng thì cả hình cũng đứng → bỏ kênh tiếng đó (viết lại PMT), phát hình không tiếng, ghi chú cho app (`take_note`).
+
+type Res<T> = Result<T, String>;
+
+/// Một đoạn đã cắt: (thời lượng s, dữ liệu TS, gián đoạn trước đoạn này).
+pub type Out = (f64, Vec<u8>, bool);
+
+/// Độ dài đoạn tối thiểu (90 kHz): cắt ở khung khoá đầu tiên sau mốc này.
+const TARGET: i64 = 2 * 90_000;
+/// Đoạn dài quá mức này mà chưa gặp khung khoá (GOP rất dài / cờ khung khoá không có): cắt ở đầu gói PES hình bất kỳ.
+const MAX_SEG: i64 = 10 * 90_000;
+/// Mốc thời gian nhảy quá mức này = máy chủ khởi động lại luồng → đoạn mới, đánh dấu gián đoạn.
+const JUMP: i64 = 10 * 90_000;
+/// Đọc chừng này byte mà chưa thấy PAT / PMT có kênh hình / tiếng: không phải luồng MPEG-TS dùng được.
+const GIVE_UP: usize = 4 * 1024 * 1024;
+const PKT: usize = 188;
+
+/// Chờ biết tầng của tiếng MPEG (MP2 hay MP3) tối đa chừng này (90 kHz, tính từ gói hình đầu) trước khi cắt đoạn đầu.
+const PROBE: i64 = 2 * 90_000;
+
+#[derive(Default)]
+pub struct Segmenter {
+    buf: Vec<u8>,
+    pmt_pid: Option<u16>,
+    pat: Option<Vec<u8>>,
+    pmt: Option<Vec<u8>>,
+    /// PMT gốc: phần đầu bảng (tới hết program_info) và từng mục kênh (stream_type, PID, byte gốc)
+    pmt_head: Vec<u8>,
+    pmt_es: Vec<(u8, u16, Vec<u8>)>,
+    video: Option<u16>,
+    audio: Vec<u16>,
+    /// Kênh tiếng MPEG chưa biết tầng / kênh tiếng MP1 / MP2 đã bỏ
+    pending: Vec<u16>,
+    dropped: Vec<u16>,
+    checked: Vec<u16>,
+    first_video: Option<i64>,
+    note: Option<String>,
+    /// Gợi ý khi máy không lên hình (vd hình xen kẽ mã từng trường — PAFF), xét một lần
+    hint: Option<String>,
+    sps: Option<(u32, bool, bool, bool)>,
+    field_checked: bool,
+    pcr: Option<u16>,
+    cc_pat: u8,
+    cc_pmt: u8,
+    cur: Vec<u8>,
+    /// Đoạn đang gom đã bắt đầu (gặp khung khoá đầu tiên — hoặc gói tiếng đầu với luồng chỉ có tiếng)
+    started: bool,
+    seg_start: i64,
+    last_pts: Option<i64>,
+    disc_next: bool,
+    seen: usize,
+}
+
+fn pts_of(pes: &[u8]) -> Option<i64> {
+    // 00 00 01 | stream_id | len(2) | cờ(2) | độ dài phần đầu | PTS (5 byte)
+    if pes.len() < 14 || pes[0] != 0 || pes[1] != 0 || pes[2] != 1 || pes[7] & 0x80 == 0 {
+        return None;
+    }
+    let p = &pes[9..14];
+    Some(((p[0] as i64 >> 1) & 0x07) << 30 | (p[1] as i64) << 22 | ((p[2] as i64) >> 1) << 15 | (p[3] as i64) << 7 | (p[4] as i64) >> 1)
+}
+
+/// Phần tải của gói PES chứa NAL IDR (5) hoặc SPS (7) — khung khoá H.264 khi bộ mã hoá không đặt cờ random_access.
+fn has_idr(pes: &[u8]) -> bool {
+    if pes.len() < 9 {
+        return false;
+    }
+    let body = &pes[(9 + pes[8] as usize).min(pes.len())..];
+    body.windows(4).any(|w| w[0] == 0 && w[1] == 0 && w[2] == 1 && matches!(w[3] & 0x1F, 5 | 7))
+}
+
+/// Bảng PSI (PAT / PMT) trong phần tải gói mở đầu: bỏ pointer_field.
+fn section(payload: &[u8]) -> Option<&[u8]> {
+    let ptr = *payload.first()? as usize;
+    payload.get(1 + ptr..)
+}
+
+/// CRC-32 của bảng PSI (MPEG-2: đa thức 0x04C11DB7, không đảo bit).
+fn crc32_mpeg(d: &[u8]) -> u32 {
+    let mut crc = 0xFFFF_FFFFu32;
+    for &b in d {
+        crc ^= (b as u32) << 24;
+        for _ in 0..8 {
+            crc = if crc & 0x8000_0000 != 0 { (crc << 1) ^ 0x04C1_1DB7 } else { crc << 1 };
+        }
+    }
+    crc
+}
+
+/// Đọc bit (NAL đã bỏ byte chống giả mã 00 00 03).
+struct Bits<'a> {
+    d: &'a [u8],
+    pos: usize,
+}
+
+impl<'a> Bits<'a> {
+    fn u(&mut self, n: usize) -> Option<u32> {
+        let mut v = 0u32;
+        for _ in 0..n {
+            let byte = *self.d.get(self.pos / 8)?;
+            v = (v << 1) | ((byte >> (7 - self.pos % 8)) & 1) as u32;
+            self.pos += 1;
+        }
+        Some(v)
+    }
+    fn ue(&mut self) -> Option<u32> {
+        let mut zeros = 0;
+        while self.u(1)? == 0 {
+            zeros += 1;
+            if zeros > 31 {
+                return None;
+            }
+        }
+        Some((1u32 << zeros) - 1 + self.u(zeros)?)
+    }
+    fn se(&mut self) -> Option<i32> {
+        let k = self.ue()?;
+        Some(if k % 2 == 1 { k.div_ceil(2) as i32 } else { -((k / 2) as i32) })
+    }
+}
+
+fn unescape(nal: &[u8]) -> Vec<u8> {
+    let mut out = Vec::with_capacity(nal.len());
+    let mut zeros = 0;
+    for &b in nal {
+        if zeros >= 2 && b == 3 {
+            zeros = 0;
+            continue;
+        }
+        zeros = if b == 0 { zeros + 1 } else { 0 };
+        out.push(b);
+    }
+    out
+}
+
+/// Phần SPS H.264 cần để đọc đầu lát: (log2_max_frame_num, frame_mbs_only, mb_adaptive_frame_field, separate_colour_plane)
+fn parse_sps(rbsp: &[u8]) -> Option<(u32, bool, bool, bool)> {
+    let mut b = Bits { d: rbsp, pos: 8 }; // bỏ byte đầu NAL
+    let profile = b.u(8)?;
+    b.u(16)?; // ràng buộc + level
+    b.ue()?; // sps_id
+    let mut separate = false;
+    if matches!(profile, 100 | 110 | 122 | 244 | 44 | 83 | 86 | 118 | 128 | 138 | 139 | 134 | 135) {
+        let chroma = b.ue()?;
+        if chroma == 3 {
+            separate = b.u(1)? == 1;
+        }
+        b.ue()?;
+        b.ue()?;
+        b.u(1)?;
+        if b.u(1)? == 1 {
+            for i in 0..(if chroma == 3 { 12 } else { 8 }) {
+                if b.u(1)? == 1 {
+                    let (mut last, mut next) = (8i32, 8i32);
+                    for _ in 0..(if i < 6 { 16 } else { 64 }) {
+                        if next != 0 {
+                            next = (last + b.se()? + 256) % 256;
+                        }
+                        if next != 0 {
+                            last = next;
+                        }
+                    }
+                }
+            }
+        }
+    }
+    let log2_frame_num = b.ue()? + 4;
+    match b.ue()? {
+        0 => {
+            b.ue()?;
+        }
+        1 => {
+            b.u(1)?;
+            b.se()?;
+            b.se()?;
+            for _ in 0..b.ue()? {
+                b.se()?;
+            }
+        }
+        _ => {}
+    }
+    b.ue()?; // max_num_ref_frames
+    b.u(1)?;
+    b.ue()?;
+    b.ue()?;
+    let frame_mbs_only = b.u(1)? == 1;
+    let mbaff = !frame_mbs_only && b.u(1)? == 1;
+    Some((log2_frame_num, frame_mbs_only, mbaff, separate))
+}
+
+/// Lát (NAL 1 / 5) mã từng trường (field_pic_flag = 1)?
+fn slice_is_field(rbsp: &[u8], sps: (u32, bool, bool, bool)) -> Option<bool> {
+    let (log2_frame_num, frame_mbs_only, _, separate) = sps;
+    if frame_mbs_only {
+        return Some(false);
+    }
+    let mut b = Bits { d: rbsp, pos: 8 };
+    b.ue()?;
+    b.ue()?;
+    b.ue()?;
+    if separate {
+        b.u(2)?;
+    }
+    b.u(log2_frame_num as usize)?;
+    Some(b.u(1)? == 1)
+}
+
+/// Các NAL trong phần tải PES (Annex B): [(loại, NAL kể cả byte đầu)]
+fn nals(pes: &[u8]) -> Vec<(u8, &[u8])> {
+    if pes.len() < 9 {
+        return Vec::new();
+    }
+    let body = &pes[(9 + pes[8] as usize).min(pes.len())..];
+    let starts: Vec<usize> = body.windows(3).enumerate().filter(|(_, w)| w[0] == 0 && w[1] == 0 && w[2] == 1).map(|(i, _)| i + 3).collect();
+    starts
+        .iter()
+        .enumerate()
+        .filter(|(_, &s)| s < body.len())
+        .map(|(k, &s)| {
+            let e = starts.get(k + 1).map(|&n| n - 3).unwrap_or(body.len());
+            (body[s] & 0x1F, &body[s..e.max(s)])
+        })
+        .collect()
+}
+
+/// Tầng của tiếng MPEG trong phần tải PES (1, 2, 3); None = chưa thấy đầu khung.
+fn mpeg_audio_layer(pes: &[u8]) -> Option<u8> {
+    if pes.len() < 9 || pes[0] != 0 || pes[1] != 0 || pes[2] != 1 {
+        return None;
+    }
+    let body = &pes[(9 + pes[8] as usize).min(pes.len())..];
+    body.windows(2).find(|w| w[0] == 0xFF && w[1] & 0xE0 == 0xE0 && (w[1] >> 1) & 3 != 0).map(|w| 4 - ((w[1] >> 1) & 3))
+}
+
+impl Segmenter {
+    pub fn new() -> Segmenter {
+        Segmenter::default()
+    }
+
+    /// Ghi chú cho người xem (vd đã bỏ tiếng MP2), lấy một lần.
+    pub fn take_note(&mut self) -> Option<String> {
+        self.note.take()
+    }
+
+    /// Gợi ý cho app khi máy không lên hình (hình xen kẽ dạng trường — PAFF: bộ giải mã của iPad 1 không nhận), lấy một lần.
+    pub fn take_hint(&mut self) -> Option<String> {
+        self.hint.take()
+    }
+
+    /// Xét SPS / lát đầu của gói PES hình: lát mã từng trường (PAFF — kiểu bộ mã hoá đài phát sóng 1080i)?
+    fn check_fields(&mut self, payload: &[u8]) {
+        for (t, nal) in nals(payload) {
+            match t {
+                7 => self.sps = parse_sps(&unescape(nal)),
+                1 | 5 => {
+                    if let Some(sps) = self.sps {
+                        self.field_checked = true;
+                        if slice_is_field(&unescape(&nal[..nal.len().min(64)]), sps) == Some(true) {
+                            self.hint = Some("Kênh phát hình xen kẽ dạng trường (PAFF — kiểu đài phát sóng 1080i): bộ giải mã của máy \
+                                              đời cũ có thể không nhận.".into());
+                        }
+                        return;
+                    }
+                }
+                _ => {}
+            }
+        }
+    }
+
+    /// Đẩy một khúc luồng; trả các đoạn vừa cắt xong.
+    pub fn feed(&mut self, data: &[u8]) -> Res<Vec<Out>> {
+        self.buf.extend_from_slice(data);
+        self.seen += data.len();
+        let mut out = Vec::new();
+        let mut i = 0;
+        while i + PKT <= self.buf.len() {
+            if self.buf[i] != 0x47 {
+                // Lệch nhịp: tìm byte 0x47 có gói kế tiếp cũng bắt đầu bằng 0x47
+                match (i + 1..self.buf.len().saturating_sub(PKT)).find(|&j| self.buf[j] == 0x47 && self.buf[j + PKT] == 0x47) {
+                    Some(j) => i = j,
+                    None => {
+                        i = self.buf.len().saturating_sub(PKT);
+                        break;
+                    }
+                }
+                continue;
+            }
+            let pkt: [u8; PKT] = self.buf[i..i + PKT].try_into().unwrap();
+            self.packet(&pkt, &mut out)?;
+            i += PKT;
+        }
+        self.buf.drain(..i);
+        if self.pmt.is_none() && self.seen > GIVE_UP {
+            return Err("không phải luồng MPEG-TS (không thấy bảng chương trình)".into());
+        }
+        Ok(out)
+    }
+
+    fn packet(&mut self, p: &[u8; PKT], out: &mut Vec<Out>) -> Res<()> {
+        let pusi = p[1] & 0x40 != 0;
+        let pid = ((p[1] as u16 & 0x1F) << 8) | p[2] as u16;
+        let afc = (p[3] >> 4) & 3;
+        let mut off = 4;
+        let mut rai = false;
+        if afc & 2 != 0 {
+            let len = p[4] as usize;
+            if len > 0 && 5 < PKT {
+                rai = p[5] & 0x40 != 0;
+            }
+            off = 5 + len;
+        }
+        let payload: &[u8] = if afc & 1 != 0 && off < PKT { &p[off..] } else { &[] };
+        if pid == 0 {
+            if pusi {
+                self.read_pat(p, payload);
+            }
+            return Ok(());
+        }
+        if Some(pid) == self.pmt_pid {
+            if pusi {
+                self.read_pmt(p, payload)?;
+            }
+            return Ok(());
+        }
+        let is_video = Some(pid) == self.video;
+        let is_audio = self.audio.contains(&pid);
+        if !is_video && !is_audio && Some(pid) != self.pcr {
+            return Ok(()); // bảng phụ, phụ đề, teletext, kênh tiếng đã bỏ…
+        }
+        if pusi && is_audio && self.pending.contains(&pid) {
+            if let Some(layer) = mpeg_audio_layer(payload) {
+                self.pending.retain(|&x| x != pid);
+                if layer == 3 {
+                    self.checked.push(pid);
+                } else {
+                    // MP1 / MP2: AVPlayer iOS cũ không giải mã — bỏ kênh tiếng, phát hình không tiếng
+                    self.dropped.push(pid);
+                    self.audio.retain(|&x| x != pid);
+                    if self.video.is_none() && self.audio.is_empty() {
+                        return Err(format!("tiếng MP{layer} — máy iOS 5 / 6 không giải mã được tiếng này"));
+                    }
+                    self.note = Some(format!("Kênh phát tiếng MP{layer} — máy iOS 5 / 6 không giải mã được tiếng này: phát hình không tiếng."));
+                    self.rebuild_pmt();
+                    return Ok(());
+                }
+            }
+        }
+        if pusi && is_video && !self.field_checked {
+            self.check_fields(payload);
+        }
+        if pusi && (is_video || (is_audio && self.video.is_none())) {
+            if let Some(pts) = pts_of(payload) {
+                self.at_pes(pts, is_video && (rai || has_idr(payload)), is_video, out);
+            }
+        }
+        if self.started {
+            self.cur.extend_from_slice(p);
+        }
+        Ok(())
+    }
+
+    /// Đầu một gói PES hình (hoặc tiếng, luồng chỉ có tiếng): cắt đoạn khi đủ dài và đang ở khung khoá.
+    fn at_pes(&mut self, pts: i64, key: bool, video: bool, out: &mut Vec<Out>) {
+        if let Some(last) = self.last_pts {
+            if (pts - last).abs() > JUMP {
+                // Máy chủ khởi động lại luồng / mốc 33 bit quay vòng: cắt đoạn đang gom, đoạn sau gián đoạn
+                self.flush(last, out);
+                self.started = false;
+                self.disc_next = true;
+            }
+        }
+        self.last_pts = Some(pts);
+        if video && self.first_video.is_none() {
+            self.first_video = Some(pts);
+        }
+        let can_start = key || !video;
+        if !self.started {
+            // Tiếng MPEG chưa biết tầng: chờ gói tiếng đầu (tối đa 2 s) — MP2 thì PMT đoạn đầu đã phải bỏ kênh tiếng
+            let probing = !self.pending.is_empty() && pts - self.first_video.unwrap_or(pts) < PROBE;
+            if can_start && !probing {
+                self.begin(pts);
+            }
+            return;
+        }
+        let len = pts - self.seg_start;
+        if (can_start && len >= TARGET) || (video && len >= MAX_SEG) {
+            self.flush(pts, out);
+            self.begin(pts);
+        }
+    }
+
+    fn begin(&mut self, pts: i64) {
+        self.started = true;
+        self.seg_start = pts;
+        self.cur.clear();
+        // PAT + PMT mở đầu đoạn, bộ đếm liên tục riêng (bản gốc trong luồng bỏ đi)
+        if let (Some(pat), Some(pmt)) = (&self.pat, &self.pmt) {
+            let mut a = pat.clone();
+            a[3] = (a[3] & 0xF0) | (self.cc_pat & 0x0F);
+            self.cc_pat = self.cc_pat.wrapping_add(1);
+            let mut b = pmt.clone();
+            b[3] = (b[3] & 0xF0) | (self.cc_pmt & 0x0F);
+            self.cc_pmt = self.cc_pmt.wrapping_add(1);
+            self.cur.extend_from_slice(&a);
+            self.cur.extend_from_slice(&b);
+        }
+    }
+
+    fn flush(&mut self, pts: i64, out: &mut Vec<Out>) {
+        if !self.started || self.cur.len() <= 2 * PKT {
+            return;
+        }
+        let dur = ((pts - self.seg_start) as f64 / 90_000.0).max(0.1);
+        out.push((dur, std::mem::take(&mut self.cur), std::mem::take(&mut self.disc_next)));
+    }
+
+    fn read_pat(&mut self, p: &[u8; PKT], payload: &[u8]) {
+        let Some(s) = section(payload) else { return };
+        if s.len() < 8 || s[0] != 0 {
+            return;
+        }
+        let len = (((s[1] as usize & 0x0F) << 8) | s[2] as usize).min(s.len().saturating_sub(3));
+        // Các mục (4 byte) từ byte 8 tới trước CRC
+        let mut k = 8;
+        while k + 4 <= 3 + len.saturating_sub(4) {
+            let program = ((s[k] as u16) << 8) | s[k + 1] as u16;
+            let pid = ((s[k + 2] as u16 & 0x1F) << 8) | s[k + 3] as u16;
+            if program != 0 {
+                if self.pmt_pid != Some(pid) {
+                    self.pmt_pid = Some(pid);
+                    self.pmt = None;
+                }
+                self.pat = Some(p.to_vec());
+                return;
+            }
+            k += 4;
+        }
+    }
+
+    fn read_pmt(&mut self, p: &[u8; PKT], payload: &[u8]) -> Res<()> {
+        let Some(s) = section(payload) else { return Ok(()) };
+        if s.len() < 12 || s[0] != 2 {
+            return Ok(());
+        }
+        let len = (((s[1] as usize & 0x0F) << 8) | s[2] as usize).min(s.len().saturating_sub(3));
+        let pcr = ((s[8] as u16 & 0x1F) << 8) | s[9] as u16;
+        let info = ((s[10] as usize & 0x0F) << 8) | s[11] as usize;
+        let end = 3 + len.saturating_sub(4);
+        if 12 + info > end {
+            return Ok(());
+        }
+        let mut k = 12 + info;
+        let (mut video, mut audio, mut bad, mut es) = (None, Vec::new(), None, Vec::new());
+        while k + 5 <= end {
+            let st = s[k];
+            let pid = ((s[k + 1] as u16 & 0x1F) << 8) | s[k + 2] as u16;
+            let n = ((s[k + 3] as usize & 0x0F) << 8) | s[k + 4] as usize;
+            match st {
+                0x1B if video.is_none() => video = Some(pid),
+                0x24 => bad = Some("mã hình H.265 (HEVC) — máy iOS 5 / 6 chỉ giải mã H.264"),
+                0x01 | 0x02 => bad = Some("mã hình MPEG-2 — máy iOS 5 / 6 chỉ giải mã H.264"),
+                0x03 | 0x04 | 0x0F | 0x81 => audio.push(pid),
+                _ => {}
+            }
+            es.push((st, pid, s[k..(k + 5 + n).min(end)].to_vec()));
+            k += 5 + n;
+        }
+        if video.is_none() {
+            if let Some(b) = bad {
+                return Err(b.into());
+            }
+        }
+        if video.is_none() && audio.is_empty() {
+            return Ok(());
+        }
+        // Tiếng MPEG (stream_type 3 / 4) có thể là MP2 (máy cũ không giải mã) hay MP3: xét ở gói tiếng đầu
+        for (st, pid, _) in &es {
+            if matches!(st, 0x03 | 0x04) && ![&self.pending, &self.dropped, &self.checked].iter().any(|l| l.contains(pid)) {
+                self.pending.push(*pid);
+            }
+        }
+        audio.retain(|a| !self.dropped.contains(a));
+        self.video = video;
+        self.audio = audio;
+        self.pcr = Some(pcr).filter(|&p| p != 0x1FFF);
+        self.pmt_head = s[..12 + info].to_vec();
+        self.pmt_es = es;
+        self.pmt = Some(p.to_vec());
+        self.rebuild_pmt();
+        Ok(())
+    }
+
+    /// Gói PMT mở đầu đoạn: bảng gốc bỏ các kênh tiếng đã loại, tính lại CRC; bảng dài quá một gói thì giữ bản gốc.
+    fn rebuild_pmt(&mut self) {
+        let Some(pid) = self.pmt_pid else { return };
+        if self.pmt_head.len() < 12 {
+            return;
+        }
+        let mut sec = self.pmt_head.clone();
+        for (_, p, raw) in &self.pmt_es {
+            if !self.dropped.contains(p) {
+                sec.extend_from_slice(raw);
+            }
+        }
+        let len = sec.len() - 3 + 4;
+        sec[1] = (sec[1] & 0xF0) | ((len >> 8) as u8 & 0x0F);
+        sec[2] = len as u8;
+        let crc = crc32_mpeg(&sec);
+        sec.extend_from_slice(&crc.to_be_bytes());
+        let mut pkt = vec![0x47, 0x40 | ((pid >> 8) as u8 & 0x1F), pid as u8, 0x10, 0x00];
+        pkt.extend_from_slice(&sec);
+        if pkt.len() <= PKT {
+            pkt.resize(PKT, 0xFF);
+            self.pmt = Some(pkt);
+        }
+    }
+}
