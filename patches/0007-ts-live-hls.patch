+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn packet(pid: u16, pusi: bool, rai: bool, cc: u8, payload: &[u8]) -> Vec<u8> {
+        let mut p = vec![0x47, (if pusi { 0x40 } else { 0 }) | (pid >> 8) as u8 & 0x1F, pid as u8];
+        let room = PKT - 4;
+        let need_af = rai || payload.len() < room;
+        if need_af {
+            let af_len = room - 1 - payload.len().min(room - 2);
+            p.push(0x30 | (cc & 0x0F));
+            p.push(af_len as u8);
+            if af_len > 0 {
+                p.push(if rai { 0x40 } else { 0 });
+                p.extend(std::iter::repeat(0xFF).take(af_len - 1));
+            }
+        } else {
+            p.push(0x10 | (cc & 0x0F));
+        }
+        p.extend_from_slice(&payload[..payload.len().min(PKT - p.len())]);
+        assert_eq!(p.len(), PKT);
+        p
+    }
+
+    fn psi(table: u8, body: &[u8]) -> Vec<u8> {
+        let len = body.len() + 5 + 4; // phần sau section_length: 5 byte đầu + thân + CRC
+        let mut s = vec![0, table, 0xB0 | (len >> 8) as u8, len as u8, 0, 1, 0xC1, 0, 0];
+        s.extend_from_slice(body);
+        s.extend_from_slice(&[0, 0, 0, 0]);
+        s
+    }
+
+    fn pat() -> Vec<u8> {
+        packet(0, true, false, 0, &psi(0, &[0, 1, 0xE1, 0x00]))
+    }
+
+    fn pmt_with(video_type: u8, audio_type: u8) -> Vec<u8> {
+        packet(0x100, true, false, 0, &psi(2, &[0xE1, 0x01, 0xF0, 0x00, video_type, 0xE1, 0x01, 0xF0, 0x00, audio_type, 0xE1, 0x02, 0xF0, 0x00]))
+    }
+
+    fn pmt(video_type: u8) -> Vec<u8> {
+        pmt_with(video_type, 0x0F)
+    }
+
+    /// Gói PES tiếng MPEG (pid 0x102): byte thứ hai của đầu khung quyết định tầng (0xFD = Layer II, 0xFB = Layer III)
+    fn audio_pes(pts: i64, layer_byte: u8) -> Vec<u8> {
+        let mut v = pes(pts, false);
+        v[3] = 0xC0;
+        v.truncate(14);
+        v.extend_from_slice(&[0xFF, layer_byte, 0x90, 0x44, 0, 0, 0, 0]);
+        v
+    }
+
+    /// Hình như `stream`, tiếng MPEG chen giữa (gói tiếng đầu tới trước khung khoá đầu)
+    fn stream_mpeg_audio(layer_byte: u8) -> Vec<u8> {
+        let mut v = pat();
+        v.extend(pmt_with(0x1B, 0x03));
+        let mut cc = 0u8;
+        for f in 0..18i64 {
+            let pts = 900_000 + f * 45_000;
+            v.extend(packet(0x102, true, false, f as u8, &audio_pes(pts, layer_byte)));
+            v.extend(packet(0x101, true, f % 2 == 0, cc, &pes(pts, false)));
+            cc = cc.wrapping_add(1);
+        }
+        v
+    }
+
+    fn pids(data: &[u8]) -> Vec<u16> {
+        data.chunks(PKT).map(|p| ((p[1] as u16 & 0x1F) << 8) | p[2] as u16).collect()
+    }
+
+    #[test]
+    fn mp2_audio_dropped() {
+        let mut sg = Segmenter::new();
+        let segs = sg.feed(&stream_mpeg_audio(0xFD)).unwrap();
+        assert_eq!(segs.len(), 4);
+        assert!(sg.take_note().unwrap().contains("MP2"));
+        for (_, data, _) in &segs {
+            assert!(!pids(data).contains(&0x102), "còn gói tiếng MP2");
+            // PMT mới: chỉ còn kênh hình, CRC đúng (CRC cả bảng kèm CRC = 0)
+            let s = &data[PKT + 5..];
+            let len = ((s[1] as usize & 0x0F) << 8) | s[2] as usize;
+            assert_eq!(crc32_mpeg(&s[..3 + len]), 0);
+            assert_eq!(len, 9 + 4 + 5);
+            assert_eq!(s[12], 0x1B);
+        }
+    }
+
+    #[test]
+    fn mp3_audio_kept() {
+        let mut sg = Segmenter::new();
+        let segs = sg.feed(&stream_mpeg_audio(0xFB)).unwrap();
+        assert_eq!(segs.len(), 4);
+        assert!(sg.take_note().is_none());
+        assert!(pids(&segs[0].1).contains(&0x102));
+        let s = &segs[0].1[PKT + 5..];
+        let len = ((s[1] as usize & 0x0F) << 8) | s[2] as usize;
+        assert_eq!(len, 9 + 4 + 10);
+        assert_eq!(crc32_mpeg(&s[..3 + len]), 0);
+    }
+
+    fn pes(pts: i64, idr: bool) -> Vec<u8> {
+        let mut v = vec![0, 0, 1, 0xE0, 0, 0, 0x80, 0x80, 5];
+        v.push(0x21 | ((pts >> 29) & 0x0E) as u8);
+        v.push((pts >> 22) as u8);
+        v.push(0x01 | ((pts >> 14) & 0xFE) as u8);
+        v.push((pts >> 7) as u8);
+        v.push(0x01 | ((pts << 1) & 0xFE) as u8);
+        v.extend_from_slice(&[0, 0, 0, 1, if idr { 0x65 } else { 0x41 }, 0x88]);
+        v
+    }
+
+    /// 1 khung hình mỗi 0,5 s (2 gói), khung khoá mỗi 1 s (cờ random_access ở khung khoá lẻ, NAL IDR ở khung khoá chẵn)
+    fn stream(secs: i64, video_type: u8, start: i64) -> Vec<u8> {
+        let mut v = pat();
+        v.extend(pmt(video_type));
+        let mut cc = 0u8;
+        for f in 0..secs * 2 {
+            let pts = start + f * 45_000;
+            let key = f % 2 == 0;
+            v.extend(packet(0x101, true, key && f % 4 == 0, cc, &pes(pts, key && f % 4 != 0)));
+            cc = cc.wrapping_add(1);
+            v.extend(packet(0x101, false, false, cc, &[0xAB; 184]));
+            cc = cc.wrapping_add(1);
+            v.extend(packet(0x111, true, false, 0, &[1, 2, 3])); // EIT / phụ: bỏ
+            if f % 10 == 0 {
+                v.extend(pat());
+                v.extend(pmt(video_type));
+            }
+        }
+        v
+    }
+
+    #[test]
+    fn cuts_at_keyframes_any_chunking() {
+        let s = stream(9, 0x1B, 900_000);
+        for step in [100, 188, 1000, 7000, s.len()] {
+            let mut sg = Segmenter::new();
+            let mut segs = Vec::new();
+            for c in s.chunks(step) {
+                segs.extend(sg.feed(c).unwrap());
+            }
+            let durs: Vec<f64> = segs.iter().map(|x| x.0).collect();
+            assert_eq!(durs, vec![2.0, 2.0, 2.0, 2.0], "bước {step}");
+            for (_, data, disc) in &segs {
+                assert!(!disc);
+                assert_eq!(data.len() % PKT, 0);
+                // Mở đầu: PAT (pid 0) rồi PMT (pid 0x100), sau đó gói hình mở đầu PES
+                assert_eq!(((data[1] as u16 & 0x1F) << 8) | data[2] as u16, 0);
+                assert_eq!(((data[PKT + 1] as u16 & 0x1F) << 8) | data[PKT + 2] as u16, 0x100);
+                assert_eq!(((data[2 * PKT + 1] as u16 & 0x1F) << 8) | data[2 * PKT + 2] as u16, 0x101);
+                assert!(data[2 * PKT + 1] & 0x40 != 0);
+                // Không còn gói phụ / PAT, PMT gốc chen giữa
+                assert!(data.chunks(PKT).skip(2).all(|p| (((p[1] as u16 & 0x1F) << 8) | p[2] as u16) == 0x101));
+            }
+            // Bộ đếm liên tục của PAT tăng dần qua các đoạn
+            let ccs: Vec<u8> = segs.iter().map(|x| x.1[3] & 0x0F).collect();
+            assert_eq!(ccs, vec![0, 1, 2, 3]);
+        }
+    }
+
+    #[test]
+    fn garbage_before_and_jump() {
+        let mut s = vec![0x12; 77];
+        s.extend(stream(5, 0x1B, 900_000));
+        // Máy chủ khởi động lại: mốc thời gian nhảy về 0
+        s.extend(stream(5, 0x1B, 0));
+        let mut sg = Segmenter::new();
+        let segs = sg.feed(&s).unwrap();
+        let disc: Vec<bool> = segs.iter().map(|x| x.2).collect();
+        assert!(segs.len() >= 3);
+        assert!(disc.contains(&true));
+        assert!(!disc[0]);
+    }
+
+    #[test]
+    fn hevc_and_not_ts() {
+        let mut sg = Segmenter::new();
+        let e = sg.feed(&stream(3, 0x24, 0)).unwrap_err();
+        assert!(e.contains("H.265"), "{e}");
+        let mut sg = Segmenter::new();
+        let junk = vec![0x55u8; GIVE_UP + 1000];
+        assert!(sg.feed(&junk).unwrap_err().contains("MPEG-TS"));
+    }
+
+    #[test]
+    fn audio_only() {
+        // Chỉ có tiếng (đài radio dạng TS): cắt theo mốc tiếng
+        let mut v = pat();
+        v.extend(packet(0x100, true, false, 0, &psi(2, &[0xE1, 0x02, 0xF0, 0x00, 0x0F, 0xE1, 0x02, 0xF0, 0x00])));
+        for f in 0..20i64 {
+            let mut p = pes(f * 45_000, false);
+            p[3] = 0xC0;
+            v.extend(packet(0x102, true, false, f as u8, &p));
+        }
+        let mut sg = Segmenter::new();
+        let durs: Vec<f64> = sg.feed(&v).unwrap().iter().map(|x| x.0).collect();
+        assert_eq!(durs, vec![2.0, 2.0, 2.0, 2.0]);
+    }
+}
