@@ -0,0 +1,561 @@
+//! Luồng HTTP-FLV trực tiếp (máy chủ phát bóng đá / IPTV: «…/live/xxx.flv», H.264 + AAC) → HLS trực tiếp cho AVPlayer của iOS
+//! cũ (chỉ phát HLS dạng MPEG-TS). Chỉ đổi vỏ, không giải mã: đọc thẻ FLV liên tục, H.264 → Annex B (SPS / PPS trước khung
+//! khoá), AAC → ADTS (dùng bộ ghi TS của fmp4_ts), cắt đoạn ~2 s tại khung khoá, giữ vài đoạn mới nhất trong bộ nhớ; cổng phát
+//! nội bộ trả danh sách phát trực tiếp (cửa sổ trượt) và từng đoạn. H.265 trong FLV (codec 12 / FLV mở rộng) không phát được
+//! trên máy cũ → báo lỗi rõ.
+
+use crate::fmp4_ts::{aac_params, adts_header, annex_b, avcc, pat, pes_header, pmt, ts_packets, PID_AUDIO, PID_VIDEO};
+use std::collections::VecDeque;
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::{Arc, Mutex};
+use std::time::Instant;
+
+/// Độ dài đoạn tối thiểu (90 kHz): cắt ở khung khoá đầu tiên sau mốc này.
+const TARGET: i128 = 2 * 90_000;
+/// Luồng không có hình: cắt theo thời lượng tiếng.
+const AUDIO_TARGET: i128 = 2 * 90_000;
+/// Số đoạn giữ trong bộ nhớ / ghi trong danh sách phát.
+const KEEP: usize = 8;
+const LIST: usize = 6;
+/// Số đoạn cần có trước khi trả danh sách phát (AVPlayer bắt đầu cách mép trực tiếp ~3 đoạn).
+pub const READY: usize = 3;
+/// Mốc thời gian cộng thêm (90 kHz): 10 s, như fmp4_ts.
+const OFFSET: i128 = 900_000;
+/// Số khung AAC gom vào một gói PES.
+const AUDIO_PER_PES: usize = 5;
+/// Mốc thời gian nhảy quá mức này (lùi / tiến) = máy chủ khởi động lại luồng → đoạn mới, đánh dấu gián đoạn.
+const JUMP: i128 = 10 * 90_000;
+
+type Res<T> = Result<T, String>;
+
+/// Một đoạn TS đã cắt xong.
+#[derive(Debug, Clone)]
+pub struct Seg {
+    pub seq: u64,
+    pub dur: f64,
+    pub disc: bool,
+    pub data: Arc<Vec<u8>>,
+}
+
+#[derive(Default)]
+struct State {
+    segs: VecDeque<Seg>,
+    next_seq: u64,
+    err: Option<String>,
+    ended: bool,
+    disc_next: bool,
+}
+
+/// Phiên FLV → HLS của cổng phát: việc tải chạy nền đẩy đoạn vào đây, cổng phát đọc ra.
+pub struct Live {
+    st: Mutex<State>,
+    closed: AtomicBool,
+    touched: Mutex<Instant>,
+}
+
+impl Default for Live {
+    fn default() -> Self {
+        Live { st: Mutex::new(State::default()), closed: AtomicBool::new(false), touched: Mutex::new(Instant::now()) }
+    }
+}
+
+impl Live {
+    pub fn new() -> Live {
+        Live::default()
+    }
+    /// Trình phát đóng / phiên bị bỏ: việc tải nền dừng ở lần đọc sau.
+    pub fn close(&self) {
+        self.closed.store(true, Ordering::SeqCst);
+    }
+    pub fn closed(&self) -> bool {
+        self.closed.load(Ordering::SeqCst)
+    }
+    /// Trình phát vừa hỏi danh sách phát / đoạn.
+    pub fn touch(&self) {
+        *self.touched.lock().unwrap() = Instant::now();
+    }
+    pub fn idle_secs(&self) -> u64 {
+        self.touched.lock().unwrap().elapsed().as_secs()
+    }
+    pub fn push(&self, dur: f64, data: Vec<u8>, disc: bool) {
+        let mut st = self.st.lock().unwrap();
+        let seq = st.next_seq;
+        st.next_seq += 1;
+        let disc = disc || std::mem::take(&mut st.disc_next);
+        st.segs.push_back(Seg { seq, dur, disc, data: Arc::new(data) });
+        while st.segs.len() > KEEP {
+            st.segs.pop_front();
+        }
+        st.err = None;
+    }
+    /// Nối lại luồng (đứt mạng / máy chủ khởi động lại): đoạn sau đánh dấu gián đoạn.
+    pub fn mark_discontinuity(&self) {
+        self.st.lock().unwrap().disc_next = true;
+    }
+    pub fn fail(&self, e: String) {
+        self.st.lock().unwrap().err = Some(e);
+    }
+    pub fn end(&self) {
+        self.st.lock().unwrap().ended = true;
+    }
+    pub fn seg_count(&self) -> usize {
+        self.st.lock().unwrap().segs.len()
+    }
+    /// Đủ đoạn để phát (Ok(true)), chưa (Ok(false)), hay lỗi khi chưa có đoạn nào.
+    pub fn ready(&self) -> Res<bool> {
+        let st = self.st.lock().unwrap();
+        if st.segs.len() >= READY || (st.ended && !st.segs.is_empty()) {
+            return Ok(true);
+        }
+        match &st.err {
+            Some(e) if st.segs.is_empty() => Err(e.clone()),
+            _ if st.ended => Err("luồng FLV kết thúc trước khi có hình".into()),
+            _ => Ok(false),
+        }
+    }
+    /// Danh sách phát trực tiếp: LIST đoạn mới nhất, địa chỉ đoạn = `<prefix>/w/<số>.ts`.
+    pub fn playlist(&self, prefix: &str) -> String {
+        let st = self.st.lock().unwrap();
+        let skip = st.segs.len().saturating_sub(LIST);
+        let segs: Vec<&Seg> = st.segs.iter().skip(skip).collect();
+        let target = segs.iter().map(|s| s.dur.ceil() as u64).max().unwrap_or(2).max(1);
+        let first = segs.first().map(|s| s.seq).unwrap_or(0);
+        let mut out = format!("#EXTM3U\n#EXT-X-VERSION:3\n#EXT-X-TARGETDURATION:{target}\n#EXT-X-MEDIA-SEQUENCE:{first}\n");
+        for s in segs {
+            if s.disc {
+                out.push_str("#EXT-X-DISCONTINUITY\n");
+            }
+            out.push_str(&format!("#EXTINF:{:.3},\n{prefix}/w/{}.ts\n", s.dur, s.seq));
+        }
+        if st.ended {
+            out.push_str("#EXT-X-ENDLIST\n");
+        }
+        out
+    }
+    pub fn segment(&self, seq: u64) -> Option<Arc<Vec<u8>>> {
+        self.st.lock().unwrap().segs.iter().find(|s| s.seq == seq).map(|s| s.data.clone())
+    }
+}
+
+fn be24(d: &[u8]) -> u32 {
+    ((d[0] as u32) << 16) | ((d[1] as u32) << 8) | d[2] as u32
+}
+
+/// Đọc FLV theo dòng byte, trả các đoạn TS cắt xong.
+pub struct Remuxer {
+    buf: Vec<u8>,
+    pos: usize,
+    header: bool,
+    has_video: bool,
+    has_audio: bool,
+    avc: Option<(usize, Vec<Vec<u8>>, Vec<Vec<u8>>)>,
+    aac: Option<(u8, u8, u8)>,
+    cur: Vec<u8>,
+    cur_start: Option<i128>,
+    cur_disc: bool,
+    last_dts: Option<i128>,
+    cc_v: u8,
+    cc_a: u8,
+    audio_buf: Vec<u8>,
+    audio_pts: i128,
+    audio_frames: usize,
+    first_audio: Option<i128>,
+}
+
+impl Default for Remuxer {
+    fn default() -> Self {
+        Remuxer {
+            buf: Vec::new(),
+            pos: 0,
+            header: false,
+            has_video: true,
+            has_audio: true,
+            avc: None,
+            aac: None,
+            cur: Vec::new(),
+            cur_start: None,
+            cur_disc: false,
+            last_dts: None,
+            cc_v: 0,
+            cc_a: 0,
+            audio_buf: Vec::new(),
+            audio_pts: 0,
+            audio_frames: 0,
+            first_audio: None,
+        }
+    }
+}
+
+/// Đoạn cắt xong: (thời lượng giây, dữ liệu TS, gián đoạn)
+pub type Out = (f64, Vec<u8>, bool);
+
+impl Remuxer {
+    pub fn new() -> Remuxer {
+        Remuxer::default()
+    }
+
+    pub fn feed(&mut self, data: &[u8]) -> Res<Vec<Out>> {
+        if self.pos > 1 << 20 {
+            self.buf.drain(..self.pos);
+            self.pos = 0;
+        }
+        self.buf.extend_from_slice(data);
+        let mut out = Vec::new();
+        if !self.header {
+            if self.buf.len() - self.pos < 13 {
+                return Ok(out);
+            }
+            let h = &self.buf[self.pos..];
+            if &h[..3] != b"FLV" {
+                return Err("không phải luồng FLV".into());
+            }
+            let flags = h[4];
+            if flags & 0x05 != 0 {
+                self.has_video = flags & 0x01 != 0;
+                self.has_audio = flags & 0x04 != 0;
+            }
+            let off = u32::from_be_bytes([h[5], h[6], h[7], h[8]]) as usize;
+            if self.buf.len() - self.pos < off + 4 {
+                return Ok(out);
+            }
+            self.pos += off + 4; // + PreviousTagSize0
+            self.header = true;
+        }
+        loop {
+            let avail = self.buf.len() - self.pos;
+            if avail < 11 {
+                break;
+            }
+            let h = &self.buf[self.pos..self.pos + 11];
+            let kind = h[0] & 0x1f;
+            let size = be24(&h[1..4]) as usize;
+            let ts = (((h[7] as u32) << 24) | be24(&h[4..7])) as i128;
+            if size > 16 << 20 {
+                return Err("thẻ FLV hỏng (quá lớn)".into());
+            }
+            if avail < 11 + size + 4 {
+                break;
+            }
+            let body = self.buf[self.pos + 11..self.pos + 11 + size].to_vec();
+            self.pos += 11 + size + 4;
+            if h[0] & 0x20 != 0 {
+                continue; // thẻ mã hoá (FLV có khoá) — bỏ
+            }
+            self.tag(kind, ts, &body, &mut out)?;
+        }
+        Ok(out)
+    }
+
+    fn tag(&mut self, kind: u8, ts_ms: i128, body: &[u8], out: &mut Vec<Out>) -> Res<()> {
+        if body.is_empty() {
+            return Ok(());
+        }
+        let dts = ts_ms * 90 + OFFSET;
+        match kind {
+            9 => self.video(dts, body, out),
+            8 => self.audio(dts, body, out),
+            _ => Ok(()),
+        }
+    }
+
+    /// Mốc thời gian nhảy (máy chủ khởi động lại luồng): cắt đoạn đang có, đoạn sau đánh dấu gián đoạn.
+    fn check_jump(&mut self, dts: i128, out: &mut Vec<Out>) {
+        if let Some(last) = self.last_dts {
+            // DTS của FLV tăng dần: lùi quá 0,5 s hoặc nhảy tới quá JUMP = luồng khởi động lại
+            if (dts < last - 45_000 || dts - last > JUMP) && self.cur_start.is_some() {
+                self.finish(last, out);
+                self.cur_disc = true;
+            }
+        }
+    }
+
+    fn video(&mut self, dts: i128, body: &[u8], out: &mut Vec<Out>) -> Res<()> {
+        let b0 = body[0];
+        if b0 & 0x80 != 0 {
+            return Err("luồng FLV dùng H.265 / AV1 (FLV mở rộng) — máy chỉ giải mã H.264".into());
+        }
+        let codec = b0 & 0x0f;
+        if codec == 12 {
+            return Err("luồng FLV dùng H.265 — máy chỉ giải mã H.264".into());
+        }
+        if codec != 7 {
+            return Err(format!("luồng FLV dùng mã hình {codec} — chỉ phát được H.264"));
+        }
+        if body.len() < 5 {
+            return Ok(());
+        }
+        let key = b0 >> 4 == 1;
+        let cts_raw = be24(&body[2..5]);
+        let cts = if cts_raw & 0x80_0000 != 0 { cts_raw as i128 - (1 << 24) } else { cts_raw as i128 };
+        let data = &body[5..];
+        match body[1] {
+            0 => {
+                self.avc = avcc(data);
+                if self.avc.is_none() {
+                    return Err("cấu hình H.264 của luồng FLV hỏng".into());
+                }
+                Ok(())
+            }
+            1 => {
+                let Some((nal_len, sps, pps)) = self.avc.clone() else { return Ok(()) };
+                self.check_jump(dts, out);
+                let start_new = match self.cur_start {
+                    None => key,
+                    Some(s) => key && dts - s >= TARGET,
+                };
+                if start_new {
+                    if self.cur_start.is_some() {
+                        self.finish(dts, out);
+                    }
+                    self.begin(dts);
+                }
+                if self.cur_start.is_none() {
+                    return Ok(()); // chờ khung khoá đầu tiên
+                }
+                self.last_dts = Some(dts);
+                let mut es = Vec::with_capacity(data.len() + 64);
+                let idr = annex_b(data, nal_len, &sps, &pps, &mut es);
+                let pts = dts + cts * 90;
+                let mut pes = pes_header(0xE0, pts, (pts != dts).then_some(dts), es.len());
+                pes.extend_from_slice(&es);
+                ts_packets(&mut self.cur, &mut self.cc_v, PID_VIDEO, &pes, Some(dts - 9000), key || idr);
+                Ok(())
+            }
+            _ => Ok(()),
+        }
+    }
+
+    fn audio(&mut self, dts: i128, body: &[u8], out: &mut Vec<Out>) -> Res<()> {
+        let format = body[0] >> 4;
+        if format != 10 || body.len() < 2 {
+            return Ok(()); // chỉ AAC (MP3 / Speex… trong FLV hiếm — bỏ tiếng)
+        }
+        match body[1] {
+            0 => {
+                self.aac = aac_params(&body[2..]);
+                Ok(())
+            }
+            1 => {
+                let Some((profile, freq, ch)) = self.aac else { return Ok(()) };
+                // Đầu FLV báo có hình nhưng 4 s tiếng vẫn chưa thấy cấu hình hình → luồng chỉ có tiếng (radio)
+                let first = *self.first_audio.get_or_insert(dts);
+                if self.has_video && self.avc.is_none() && dts - first > 4 * 90_000 {
+                    self.has_video = false;
+                }
+                if !self.has_video {
+                    // Chỉ có tiếng: cắt theo thời lượng
+                    self.check_jump(dts, out);
+                    match self.cur_start {
+                        None => self.begin(dts),
+                        Some(s) if dts - s >= AUDIO_TARGET => {
+                            self.finish(dts, out);
+                            self.begin(dts);
+                        }
+                        _ => {}
+                    }
+                    self.last_dts = Some(dts);
+                }
+                if self.cur_start.is_none() {
+                    return Ok(());
+                }
+                let raw = &body[2..];
+                if self.audio_frames == 0 {
+                    self.audio_pts = dts;
+                }
+                self.audio_buf.extend_from_slice(&adts_header(profile, freq, ch, raw.len()));
+                self.audio_buf.extend_from_slice(raw);
+                self.audio_frames += 1;
+                if self.audio_frames >= AUDIO_PER_PES {
+                    self.flush_audio();
+                }
+                Ok(())
+            }
+            _ => Ok(()),
+        }
+    }
+
+    fn flush_audio(&mut self) {
+        if self.audio_buf.is_empty() {
+            return;
+        }
+        let mut pes = pes_header(0xC0, self.audio_pts, None, self.audio_buf.len());
+        pes.extend_from_slice(&self.audio_buf);
+        let alone = !self.has_video;
+        ts_packets(&mut self.cur, &mut self.cc_a, PID_AUDIO, &pes, alone.then_some(self.audio_pts - 9000), alone);
+        self.audio_buf.clear();
+        self.audio_frames = 0;
+    }
+
+    fn begin(&mut self, dts: i128) {
+        self.cur.clear();
+        pat(&mut self.cur);
+        // Chỉ khai báo tiếng khi đã có cấu hình AAC (đầu FLV hay báo có tiếng dù luồng không có) — khai thừa làm trình phát chờ
+        pmt(&mut self.cur, self.has_video, self.has_audio && self.aac.is_some());
+        self.cur_start = Some(dts);
+    }
+
+    fn finish(&mut self, end: i128, out: &mut Vec<Out>) {
+        self.flush_audio();
+        let Some(start) = self.cur_start.take() else { return };
+        let dur = ((end - start).max(1) as f64) / 90_000.0;
+        out.push((dur, std::mem::take(&mut self.cur), std::mem::take(&mut self.cur_disc)));
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn tag(kind: u8, ts: u32, body: &[u8]) -> Vec<u8> {
+        let mut v = vec![kind, (body.len() >> 16) as u8, (body.len() >> 8) as u8, body.len() as u8];
+        v.extend_from_slice(&[(ts >> 16) as u8, (ts >> 8) as u8, ts as u8, (ts >> 24) as u8, 0, 0, 0]);
+        v.extend_from_slice(body);
+        v.extend_from_slice(&((11 + body.len()) as u32).to_be_bytes());
+        v
+    }
+
+    fn header(flags: u8) -> Vec<u8> {
+        let mut v = b"FLV\x01".to_vec();
+        v.push(flags);
+        v.extend_from_slice(&9u32.to_be_bytes());
+        v.extend_from_slice(&0u32.to_be_bytes());
+        v
+    }
+
+    fn avc_config() -> Vec<u8> {
+        // AVCDecoderConfigurationRecord: version 1, profile 66, compat 0, level 30, 4-byte NAL, 1 SPS, 1 PPS
+        let sps = [0x67, 0x42, 0x00, 0x1e, 0xab];
+        let pps = [0x68, 0xce, 0x3c, 0x80];
+        let mut c = vec![1, 66, 0, 30, 0xff, 0xe1, 0, sps.len() as u8];
+        c.extend_from_slice(&sps);
+        c.push(1);
+        c.extend_from_slice(&[0, pps.len() as u8]);
+        c.extend_from_slice(&pps);
+        let mut body = vec![0x17, 0, 0, 0, 0];
+        body.extend_from_slice(&c);
+        body
+    }
+
+    fn frame(key: bool, cts: u32) -> Vec<u8> {
+        let nal: &[u8] = if key { &[0x65, 0x88, 0x84, 0x00] } else { &[0x41, 0x9a, 0x00] };
+        let mut body = vec![if key { 0x17 } else { 0x27 }, 1, (cts >> 16) as u8, (cts >> 8) as u8, cts as u8];
+        body.extend_from_slice(&(nal.len() as u32).to_be_bytes());
+        body.extend_from_slice(nal);
+        body
+    }
+
+    fn aac_config() -> Vec<u8> {
+        // AAC-LC 44,1 kHz stereo: 00010 0100 0010 000
+        vec![0xAF, 0, 0x12, 0x10]
+    }
+
+    fn aac_frame() -> Vec<u8> {
+        vec![0xAF, 1, 0x21, 0x10, 0x05, 0x00]
+    }
+
+    /// 6 giây hình 25 khung/giây, khung khoá mỗi giây, tiếng AAC ~43 khung/giây
+    fn stream() -> Vec<u8> {
+        let mut v = header(0x05);
+        v.extend(tag(9, 0, &avc_config()));
+        v.extend(tag(8, 0, &aac_config()));
+        for i in 0..150u32 {
+            let t = i * 40;
+            v.extend(tag(9, t, &frame(i % 25 == 0, 80)));
+            if i % 2 == 0 {
+                v.extend(tag(8, t, &aac_frame()));
+                v.extend(tag(8, t + 23, &aac_frame()));
+            }
+        }
+        v
+    }
+
+    fn pts_of(pkt: &[u8]) -> Option<u64> {
+        // gói đầu PES: payload bắt đầu 00 00 01
+        if pkt[1] & 0x40 == 0 {
+            return None;
+        }
+        let mut i = 4;
+        if pkt[3] & 0x20 != 0 {
+            i += 1 + pkt[4] as usize;
+        }
+        let p = &pkt[i..];
+        if p.len() < 14 || p[..3] != [0, 0, 1] {
+            return None;
+        }
+        let b = &p[9..14];
+        Some(((((b[0] >> 1) & 7) as u64) << 30) | ((b[1] as u64) << 22) | (((b[2] >> 1) as u64) << 15) | ((b[3] as u64) << 7) | (b[4] >> 1) as u64)
+    }
+
+    #[test]
+    fn cuts_segments_at_keyframes() {
+        let data = stream();
+        let mut r = Remuxer::new();
+        let mut segs = Vec::new();
+        // nạp từng khúc 1000 byte như đọc mạng
+        for c in data.chunks(1000) {
+            segs.extend(r.feed(c).unwrap());
+        }
+        // khung khoá ở 0, 1, 2, …, 5 s; đoạn ≥ 2 s → cắt ở 2 s và 4 s
+        assert_eq!(segs.len(), 2, "{:?}", segs.iter().map(|s| s.0).collect::<Vec<_>>());
+        for (dur, ts, disc) in &segs {
+            assert!((*dur - 2.0).abs() < 0.01);
+            assert!(!disc);
+            assert_eq!(ts.len() % 188, 0);
+            assert_eq!(ts[0], 0x47);
+            // gói 1 = PAT, gói 2 = PMT
+            assert_eq!(((ts[1] as u16 & 0x1f) << 8) | ts[2] as u16, 0);
