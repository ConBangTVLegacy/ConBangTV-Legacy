+    /// Đoạn: 3 khung hình (IDR, P, B — trun bản 1, có cts) + 4 khung tiếng, hai traf trong một moof, data_offset theo moof.
+    fn segment(base_v: u64, base_a: u64) -> Vec<u8> {
+        segment_cts(base_v, base_a, [3003, 6006, 0])
+    }
+
+    fn segment_cts(base_v: u64, base_a: u64, ctss: [i32; 3]) -> Vec<u8> {
+        let frames: Vec<Vec<u8>> = vec![
+            [0, 0, 0, 5, 0x65, 0x88, 0x84, 0x00, 0x10].to_vec(),
+            [0, 0, 0, 3, 0x41, 0x9A, 0x02].to_vec(),
+            [0, 0, 0, 3, 0x01, 0x9E, 0x04].to_vec(),
+        ];
+        let aac: Vec<Vec<u8>> = (0..4).map(|k| vec![0x21, 0x10, k as u8, 0x55]).collect();
+        let build = |v_off: u32, a_off: u32| -> Vec<u8> {
+            let mut tv = bx(b"tfhd", &full(0, 0x020000, &1u32.to_be_bytes()));
+            tv.extend(bx(b"tfdt", &full(1, 0, &base_v.to_be_bytes())));
+            let mut run = (frames.len() as u32).to_be_bytes().to_vec();
+            run.extend_from_slice(&v_off.to_be_bytes());
+            for (k, f) in frames.iter().enumerate() {
+                run.extend_from_slice(&(f.len() as u32).to_be_bytes());
+                let cts: i32 = ctss[k];
+                run.extend_from_slice(&cts.to_be_bytes());
+            }
+            tv.extend(bx(b"trun", &full(1, 0x000001 | 0x200 | 0x800, &run)));
+            let mut ta = bx(b"tfhd", &full(0, 0x020000, &2u32.to_be_bytes()));
+            ta.extend(bx(b"tfdt", &full(0, 0, &(base_a as u32).to_be_bytes())));
+            let mut run = (aac.len() as u32).to_be_bytes().to_vec();
+            run.extend_from_slice(&a_off.to_be_bytes());
+            for f in &aac {
+                run.extend_from_slice(&(f.len() as u32).to_be_bytes());
+            }
+            ta.extend(bx(b"trun", &full(0, 0x000001 | 0x200, &run)));
+            let mut m = bx(b"mfhd", &full(0, 0, &1u32.to_be_bytes()));
+            m.extend(bx(b"traf", &tv));
+            m.extend(bx(b"traf", &ta));
+            bx(b"moof", &m)
+        };
+        let probe = build(0, 0);
+        let v_off = probe.len() as u32 + 8;
+        let a_off = v_off + frames.iter().map(|f| f.len() as u32).sum::<u32>();
+        let mut seg = bx(b"styp", b"msdh\0\0\0\0msdhmsix");
+        let moof = build(v_off, a_off);
+        seg.extend(moof);
+        let mut mdat = frames.concat();
+        mdat.extend(aac.concat());
+        seg.extend(bx(b"mdat", &mdat));
+        seg
+    }
+
+    /// Gói TS → (pid, pusi, payload).
+    fn packets(ts: &[u8]) -> Vec<(u16, bool, Vec<u8>, Option<u64>)> {
+        assert_eq!(ts.len() % 188, 0);
+        ts.chunks(188)
+            .map(|p| {
+                assert_eq!(p[0], 0x47);
+                let pid = ((p[1] as u16 & 0x1f) << 8) | p[2] as u16;
+                let afc = (p[3] >> 4) & 3;
+                let mut i = 4;
+                let mut pcr = None;
+                if afc & 2 != 0 {
+                    let l = p[4] as usize;
+                    if l > 0 && p[5] & 0x10 != 0 {
+                        let b = &p[6..12];
+                        pcr = Some(((b[0] as u64) << 25) | ((b[1] as u64) << 17) | ((b[2] as u64) << 9) | ((b[3] as u64) << 1) | (b[4] as u64 >> 7));
+                    }
+                    i = 5 + l;
+                }
+                (pid, p[1] & 0x40 != 0, p[i..].to_vec(), pcr)
+            })
+            .collect()
+    }
+
+    fn pes_ts(b: &[u8]) -> u64 {
+        (((b[0] as u64 >> 1) & 7) << 30) | ((b[1] as u64) << 22) | ((b[2] as u64 >> 1) << 15) | ((b[3] as u64) << 7) | (b[4] as u64 >> 1)
+    }
