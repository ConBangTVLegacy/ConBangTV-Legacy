+//! Đóng gói lại đoạn HLS fMP4 (EXT-X-MAP + moof/mdat — dexter.pw) thành MPEG-TS cho AVPlayer của iOS cũ (iOS 6 chỉ phát HLS
+//! dạng TS; fMP4 có từ iOS 10). Chỉ đổi vỏ, không giải mã: H.264 (avc1 / avc3) → PES dạng Annex B (thêm AUD, SPS / PPS trước
+//! khung khoá); AAC (mp4a) → khung ADTS. Mốc thời gian lấy từ tfdt (+ trun), trừ edit list, cộng 10 s như mediafilesegmenter
+//! của Apple — đoạn nào cũng tự tính được, tua tới đoạn giữa phim vẫn liền mạch với đoạn trước / sau.
+
+use std::collections::HashMap;
+
+type Res<T> = Result<T, String>;
+
+const PID_PMT: u16 = 0x1000;
+const PID_VIDEO: u16 = 0x100;
+const PID_AUDIO: u16 = 0x101;
+/// Mốc thời gian cộng thêm (90 kHz): 10 s.
+const OFFSET: i128 = 900_000;
+/// Số khung AAC gom vào một gói PES.
+const AUDIO_PER_PES: usize = 5;
+
+#[derive(Clone, Debug, PartialEq)]
+enum Codec {
+    Avc { nal_len: usize, sps: Vec<Vec<u8>>, pps: Vec<Vec<u8>> },
+    Aac { profile: u8, freq_idx: u8, channels: u8 },
+}
+
+#[derive(Clone, Debug)]
+struct Track {
+    id: u32,
+    timescale: u32,
+    /// media_time của edit list (đơn vị timescale): khung hiện đầu tiên
+    shift: i64,
+    codec: Codec,
+    def_dur: u32,
+    def_size: u32,
+}
+
+/// Đoạn khởi tạo (EXT-X-MAP) đã đọc: rãnh hình H.264 đầu tiên + rãnh tiếng AAC đầu tiên.
+#[derive(Debug)]
+pub struct Init {
+    tracks: Vec<Track>,
+    /// Khoảng lùi DTS của từng rãnh (đơn vị timescale) khi luồng có độ lệch hiển thị âm (trun bản 1): PTS = DTS + cts có thể
+    /// nhỏ hơn DTS, MPEG-TS thì không được → lùi DTS cả rãnh một khoảng cố định (như dts_shift của FFmpeg) để thứ tự giải
+    /// mã giữ nguyên. Chỉ tăng, nhớ theo luồng — các đoạn sau dùng cùng khoảng lùi.
+    dts_shift: std::sync::Mutex<HashMap<usize, i128>>,
+}
+
+impl Init {
+    fn new(tracks: Vec<Track>) -> Init {
+        Init { tracks, dts_shift: Default::default() }
+    }
+}
+
+fn be16(d: &[u8], i: usize) -> Option<u32> {
+    d.get(i..i + 2).map(|b| u16::from_be_bytes([b[0], b[1]]) as u32)
+}
+fn be24(d: &[u8], i: usize) -> Option<u32> {
+    d.get(i..i + 3).map(|b| u32::from_be_bytes([0, b[0], b[1], b[2]]))
+}
+fn be32(d: &[u8], i: usize) -> Option<u32> {
+    d.get(i..i + 4).map(|b| u32::from_be_bytes([b[0], b[1], b[2], b[3]]))
+}
+fn be64(d: &[u8], i: usize) -> Option<u64> {
+    d.get(i..i + 8).map(|b| u64::from_be_bytes([b[0], b[1], b[2], b[3], b[4], b[5], b[6], b[7]]))
+}
+
+/// Các hộp ISO BMFF nằm liền nhau trong `d`: (vị trí đầu hộp, loại, thân hộp). Hộp cụt ở cuối thì dừng.
+fn boxes(d: &[u8]) -> Vec<(usize, [u8; 4], &[u8])> {
+    let mut out = Vec::new();
+    let mut i = 0usize;
+    while i + 8 <= d.len() {
+        let mut size = be32(d, i).unwrap_or(0) as u64;
+        let typ = [d[i + 4], d[i + 5], d[i + 6], d[i + 7]];
+        let mut hdr = 8usize;
+        if size == 1 {
+            match be64(d, i + 8) {
+                Some(s) => size = s,
+                None => break,
+            }
+            hdr = 16;
+        } else if size == 0 {
+            size = (d.len() - i) as u64;
+        }
+        if size < hdr as u64 || i as u64 + size > d.len() as u64 {
+            break;
+        }
+        let end = i + size as usize;
+        out.push((i, typ, &d[i + hdr..end]));
+        i = end;
+    }
+    out
+}
+
+fn child<'a>(d: &'a [u8], typ: &[u8; 4]) -> Option<&'a [u8]> {
+    boxes(d).into_iter().find(|b| &b.1 == typ).map(|b| b.2)
+}
+
+fn path<'a>(d: &'a [u8], types: &[&[u8; 4]]) -> Option<&'a [u8]> {
+    types.iter().try_fold(d, |cur, t| child(cur, t))
+}
+
+/// Dữ liệu ngụy trang (ảnh đứng trước…): bỏ tới hộp ISO BMFF quen thuộc đầu tiên.
+fn unwrap_boxes<'a>(d: &'a [u8], first: &[&[u8; 4]]) -> &'a [u8] {
+    if d.len() >= 8 && first.iter().any(|t| d[4..8] == t[..]) {
+        return d;
+    }
+    let n = d.len().saturating_sub(8).min(1 << 20);
+    for i in 0..n {
+        if first.iter().any(|t| d[i + 4..i + 8] == t[..]) {
+            let size = be32(d, i).unwrap_or(0) as usize;
+            if size >= 8 {
+                return &d[i..];
+            }
+        }
+    }
+    d
+}
+
+/// Đọc đoạn khởi tạo (ftyp + moov).
+pub fn parse_init(data: &[u8]) -> Res<Init> {
+    let data = unwrap_boxes(data, &[b"ftyp", b"moov"]);
+    let moov = child(data, b"moov").ok_or("đoạn khởi tạo thiếu moov")?;
+    let mut trex: HashMap<u32, (u32, u32)> = HashMap::new();
+    if let Some(mvex) = child(moov, b"mvex") {
+        for (_, t, b) in boxes(mvex) {
+            if &t == b"trex" {
+                if let (Some(id), Some(dur), Some(size)) = (be32(b, 4), be32(b, 12), be32(b, 16)) {
+                    trex.insert(id, (dur, size));
+                }
+            }
+        }
+    }
+    let mut tracks = Vec::new();
+    let (mut has_video, mut has_audio) = (false, false);
+    let mut unsupported: Option<String> = None;
+    for (_, t, trak) in boxes(moov) {
+        if &t != b"trak" {
+            continue;
+        }
+        let Some(tkhd) = child(trak, b"tkhd") else { continue };
+        let Some(id) = be32(tkhd, if tkhd.first() == Some(&1) { 20 } else { 12 }) else { continue };
+        let Some(mdia) = child(trak, b"mdia") else { continue };
+        let Some(mdhd) = child(mdia, b"mdhd") else { continue };
+        let timescale = be32(mdhd, if mdhd.first() == Some(&1) { 20 } else { 12 }).unwrap_or(0);
+        if timescale == 0 {
+            continue;
+        }
+        let handler = child(mdia, b"hdlr").and_then(|h| h.get(8..12)).unwrap_or(b"????");
+        let Some(stsd) = path(mdia, &[b"minf", b"stbl", b"stsd"]) else { continue };
+        let Some((_, entry_type, entry)) = stsd.get(8..).and_then(|e| boxes(e).into_iter().next()) else { continue };
+        let codec = match (handler, &entry_type) {
+            (b"vide", b"avc1") | (b"vide", b"avc3") if !has_video => parse_avc(entry),
+            (b"soun", b"mp4a") if !has_audio => parse_mp4a(entry),
+            (b"vide", b"encv") | (b"soun", b"enca") => {
+                unsupported = Some("luồng có mã hoá DRM".into());
+                None
+            }
+            (b"vide", b"hvc1") | (b"vide", b"hev1") => {
+                unsupported = Some("hình H.265 — máy không giải mã được".into());
+                None
+            }
+            _ => None,
+        };
+        let Some(codec) = codec else { continue };
+        match codec {
+            Codec::Avc { .. } => has_video = true,
+            Codec::Aac { .. } => has_audio = true,
+        }
+        let shift = path(trak, &[b"edts", b"elst"]).map(edit_shift).unwrap_or(0);
+        let (def_dur, def_size) = trex.get(&id).copied().unwrap_or((0, 0));
+        tracks.push(Track { id, timescale, shift, codec, def_dur, def_size });
+    }
+    if tracks.is_empty() {
+        return Err(unsupported.unwrap_or_else(|| "đoạn khởi tạo không có hình H.264 / tiếng AAC".into()));
+    }
+    Ok(Init::new(tracks))
+}
+
+/// media_time của mục đầu (bỏ mục rỗng -1) trong elst.
+fn edit_shift(elst: &[u8]) -> i64 {
+    let v1 = elst.first() == Some(&1);
+    let n = be32(elst, 4).unwrap_or(0) as usize;
+    let (step, mt) = if v1 { (20, 8) } else { (12, 4) };
+    for k in 0..n.min(8) {
+        let at = 8 + k * step + mt;
+        let t = if v1 { be64(elst, at).map(|x| x as i64) } else { be32(elst, at).map(|x| x as i32 as i64) };
+        match t {
+            Some(t) if t >= 0 => return t,
+            Some(_) => continue,
+            None => break,
+        }
+    }
+    0
+}
+
+fn parse_avc(entry: &[u8]) -> Option<Codec> {
+    let c = child(entry.get(78..)?, b"avcC")?;
+    let nal_len = (*c.get(4)? & 3) as usize + 1;
+    let mut i = 5usize;
+    let sets = |count_mask: u8, i: &mut usize| -> Option<Vec<Vec<u8>>> {
+        let n = (*c.get(*i)? & count_mask) as usize;
+        *i += 1;
+        let mut v = Vec::new();
+        for _ in 0..n {
+            let len = be16(c, *i)? as usize;
+            v.push(c.get(*i + 2..*i + 2 + len)?.to_vec());
+            *i += 2 + len;
+        }
+        Some(v)
+    };
+    let sps = sets(0x1f, &mut i)?;
+    let pps = sets(0xff, &mut i).unwrap_or_default();
+    Some(Codec::Avc { nal_len, sps, pps })
+}
+
+fn parse_mp4a(entry: &[u8]) -> Option<Codec> {
+    // AudioSampleEntry: 28 byte; bản QuickTime 1 / 2 dài hơn
+    let extra = match be16(entry, 8)? {
+        1 => 16,
+        2 => 36,
+        _ => 0,
+    };
+    let esds = child(entry.get(28 + extra..)?, b"esds")?;
+    aac_config(esds.get(4..)?)
+}
+
+fn read_desc(d: &[u8], i: &mut usize) -> Option<(u8, usize)> {
+    let tag = *d.get(*i)?;
+    *i += 1;
+    let mut len = 0usize;
+    for _ in 0..4 {
+        let b = *d.get(*i)?;
+        *i += 1;
+        len = (len << 7) | (b & 0x7f) as usize;
+        if b & 0x80 == 0 {
+            break;
+        }
+    }
+    Some((tag, len))
+}
+
+/// ES_Descriptor → DecoderConfigDescriptor → AudioSpecificConfig.
+fn aac_config(d: &[u8]) -> Option<Codec> {
+    let mut i = 0usize;
+    let (tag, _) = read_desc(d, &mut i)?;
+    if tag != 0x03 {
+        return None;
+    }
+    let flags = *d.get(i + 2)?;
+    i += 3;
+    if flags & 0x80 != 0 {
+        i += 2;
+    }
+    if flags & 0x40 != 0 {
+        i += 1 + *d.get(i)? as usize;
+    }
+    if flags & 0x20 != 0 {
+        i += 2;
+    }
+    let (tag, _) = read_desc(d, &mut i)?;
+    if tag != 0x04 {
+        return None;
+    }
+    i += 13;
+    let (tag, len) = read_desc(d, &mut i)?;
+    if tag != 0x05 {
+        return None;
+    }
+    asc(d.get(i..i + len)?)
+}
+
+struct Bits<'a> {
+    d: &'a [u8],
+    pos: usize,
+}
+
+impl Bits<'_> {
+    fn read(&mut self, n: usize) -> Option<u32> {
+        let mut v = 0u32;
+        for _ in 0..n {
+            let b = *self.d.get(self.pos / 8)?;
+            v = (v << 1) | ((b >> (7 - self.pos % 8)) & 1) as u32;
+            self.pos += 1;
+        }
+        Some(v)
+    }
+}
+
+const FREQS: [u32; 13] = [96000, 88200, 64000, 48000, 44100, 32000, 24000, 22050, 16000, 12000, 11025, 8000, 7350];
+
+/// AudioSpecificConfig → thông số đầu khung ADTS. HE-AAC (SBR / PS) ghi thành AAC-LC tần số lõi — máy tự nhận SBR.
+fn asc(d: &[u8]) -> Option<Codec> {
+    let mut b = Bits { d, pos: 0 };
+    let mut aot = b.read(5)?;
+    if aot == 31 {
+        aot = 32 + b.read(6)?;
+    }
+    let mut freq_idx = b.read(4)?;
+    if freq_idx == 15 {
+        let f = b.read(24)?;
+        freq_idx = FREQS.iter().enumerate().min_by_key(|(_, x)| (**x as i64 - f as i64).abs()).map(|(k, _)| k as u32)?;
+    }
+    let channels = b.read(4)?;
+    if aot == 5 || aot == 29 {
+        if b.read(4)? == 15 {
+            b.read(24)?;
+        }
+        aot = b.read(5)?;
+    }
+    let profile = if (1..=4).contains(&aot) { aot - 1 } else { 1 };
+    Some(Codec::Aac { profile: profile as u8, freq_idx: freq_idx as u8, channels: channels as u8 })
+}
+
+/// Một mẫu (khung hình / khung tiếng) trong đoạn. `dts` / `cts` / `dur`: đơn vị timescale của rãnh (đọc ở samples);
+/// `dts` / `pts` 90 kHz tính lại trong remux.
+struct Sample<'a> {
+    track: usize,
+    dts: i128,
+    cts: i128,
+    dur: i128,
+    pts: i128,
+    data: &'a [u8],
+}
+
+fn to_90k(t: i128, timescale: u32) -> i128 {
+    (t * 90_000).div_euclid(timescale as i128)
+}
+
+/// Đọc các cặp moof / mdat của đoạn → mẫu theo thứ tự giải mã của từng rãnh (mốc thời gian theo timescale của rãnh).
+fn samples<'a>(init: &Init, seg: &'a [u8]) -> Res<Vec<Sample<'a>>> {
+    let mut out = Vec::new();
+    let mut next_dts: HashMap<u32, i128> = HashMap::new();
+    for (moof_start, typ, moof) in boxes(seg) {
+        if &typ != b"moof" {
+            continue;
+        }
+        for (_, t, traf) in boxes(moof) {
+            if &t != b"traf" {
+                continue;
+            }
+            let Some(tfhd) = child(traf, b"tfhd") else { continue };
+            let flags = be24(tfhd, 1).unwrap_or(0);
+            let Some(id) = be32(tfhd, 4) else { continue };
+            let Some(ti) = init.tracks.iter().position(|x| x.id == id) else { continue };
+            let tr = &init.tracks[ti];
+            let mut p = 8usize;
+            let mut base = moof_start as i128;
+            if flags & 0x01 != 0 {
+                base = be64(tfhd, p).ok_or("tfhd cụt")? as i128;
+                p += 8;
+            }
+            if flags & 0x02 != 0 {
+                p += 4;
+            }
+            let mut def_dur = tr.def_dur;
+            if flags & 0x08 != 0 {
+                def_dur = be32(tfhd, p).ok_or("tfhd cụt")?;
+                p += 4;
+            }
+            let mut def_size = tr.def_size;
+            if flags & 0x10 != 0 {
+                def_size = be32(tfhd, p).ok_or("tfhd cụt")?;
+            }
+            let mut dts: i128 = match child(traf, b"tfdt") {
+                Some(tfdt) if tfdt.first() == Some(&1) => be64(tfdt, 4).ok_or("tfdt cụt")? as i128,
+                Some(tfdt) => be32(tfdt, 4).ok_or("tfdt cụt")? as i128,
+                None => next_dts.get(&id).copied().unwrap_or(0),
+            };
+            let mut pos = base;
+            for (_, t, trun) in boxes(traf) {
+                if &t != b"trun" {
+                    continue;
+                }
+                let v1 = trun.first() == Some(&1);
+                let fl = be24(trun, 1).unwrap_or(0);
+                let n = be32(trun, 4).ok_or("trun cụt")? as usize;
+                let mut q = 8usize;
+                if fl & 0x01 != 0 {
+                    pos = base + be32(trun, q).ok_or("trun cụt")? as i32 as i128;
+                    q += 4;
+                }
+                if fl & 0x04 != 0 {
+                    q += 4;
+                }
+                for _ in 0..n {
+                    let mut rd = |on: bool, def: u32| -> Res<u32> {
+                        if !on {
+                            return Ok(def);
+                        }
+                        let v = be32(trun, q).ok_or("trun cụt")?;
+                        q += 4;
+                        Ok(v)
+                    };
+                    let dur = rd(fl & 0x100 != 0, def_dur)?;
+                    let size = rd(fl & 0x200 != 0, def_size)? as usize;
+                    rd(fl & 0x400 != 0, 0)?;
+                    let cts_raw = rd(fl & 0x800 != 0, 0)?;
+                    let cts = if v1 { cts_raw as i32 as i128 } else { cts_raw as i128 };
+                    if pos < 0 || pos as usize + size > seg.len() {
+                        return Err("dữ liệu mẫu nằm ngoài đoạn (đoạn tải thiếu?)".into());
+                    }
+                    let data = &seg[pos as usize..pos as usize + size];
+                    out.push(Sample { track: ti, dts, cts, dur: dur as i128, pts: 0, data });
+                    pos += size as i128;
+                    dts += dur as i128;
+                }
+            }
+            next_dts.insert(id, dts);
+        }
+    }
+    if out.is_empty() {
+        return Err("đoạn không có moof / mẫu nào".into());
+    }
+    Ok(out)
+}
+
+/// Mẫu H.264 (NAL có độ dài đứng trước) → Annex B: AUD, SPS / PPS trước khung khoá (nếu mẫu chưa có), các NAL.
+fn annex_b(sample: &[u8], nal_len: usize, sps: &[Vec<u8>], pps: &[Vec<u8>], out: &mut Vec<u8>) -> bool {
+    let mut nals: Vec<&[u8]> = Vec::new();
+    let mut i = 0usize;
+    while i + nal_len <= sample.len() {
+        let mut len = 0usize;
+        for k in 0..nal_len {
+            len = (len << 8) | sample[i + k] as usize;
+        }
+        i += nal_len;
+        if len == 0 || i + len > sample.len() {
+            break;
+        }
+        nals.push(&sample[i..i + len]);
+        i += len;
+    }
+    let kind = |n: &[u8]| n[0] & 0x1f;
+    let idr = nals.iter().any(|n| kind(n) == 5);
+    if nals.first().map(|n| kind(n)) != Some(9) {
+        out.extend_from_slice(&[0, 0, 0, 1, 0x09, 0xF0]);
+    }
+    if idr && !nals.iter().any(|n| kind(n) == 7) {
+        for s in sps.iter().chain(pps) {
+            out.extend_from_slice(&[0, 0, 0, 1]);
+            out.extend_from_slice(s);
+        }
+    }
+    for n in nals {
+        out.extend_from_slice(&[0, 0, 0, 1]);
+        out.extend_from_slice(n);
+    }
+    idr
+}
+
+fn adts_header(profile: u8, freq_idx: u8, channels: u8, payload: usize) -> [u8; 7] {
+    let len = payload + 7;
+    [
+        0xFF,
+        0xF1,
+        (profile << 6) | (freq_idx << 2) | ((channels >> 2) & 1),
+        ((channels & 3) << 6) | ((len >> 11) as u8 & 3),
+        (len >> 3) as u8,
+        (((len & 7) << 5) as u8) | 0x1F,
+        0xFC,
+    ]
+}
+
+fn crc32_mpeg(d: &[u8]) -> u32 {
+    let mut c = 0xFFFF_FFFFu32;
+    for &b in d {
+        c ^= (b as u32) << 24;
+        for _ in 0..8 {
+            c = if c & 0x8000_0000 != 0 { (c << 1) ^ 0x04C1_1DB7 } else { c << 1 };
+        }
+    }
+    c
+}
+
+fn psi_packet(out: &mut Vec<u8>, pid: u16, section: &[u8]) {
+    let mut pkt = [0xFFu8; 188];
+    pkt[0] = 0x47;
+    pkt[1] = 0x40 | ((pid >> 8) as u8 & 0x1f);
+    pkt[2] = pid as u8;
+    pkt[3] = 0x10;
+    pkt[4] = 0; // pointer_field
+    let crc = crc32_mpeg(section);
+    pkt[5..5 + section.len()].copy_from_slice(section);
+    pkt[5 + section.len()..9 + section.len()].copy_from_slice(&crc.to_be_bytes());
+    out.extend_from_slice(&pkt);
+}
+
+fn pat(out: &mut Vec<u8>) {
+    let s = [0x00, 0xB0, 13, 0x00, 0x01, 0xC1, 0x00, 0x00, 0x00, 0x01, 0xE0 | (PID_PMT >> 8) as u8, PID_PMT as u8];
+    psi_packet(out, 0, &s);
+}
+
+fn pmt(out: &mut Vec<u8>, video: bool, audio: bool) {
+    let pcr = if video { PID_VIDEO } else { PID_AUDIO };
+    let mut streams: Vec<(u8, u16)> = Vec::new();
+    if video {
+        streams.push((0x1B, PID_VIDEO));
+    }
+    if audio {
+        streams.push((0x0F, PID_AUDIO));
+    }
+    let len = 9 + 5 * streams.len() + 4;
+    let mut s = vec![0x02, 0xB0 | (len >> 8) as u8, len as u8, 0x00, 0x01, 0xC1, 0x00, 0x00];
+    s.extend_from_slice(&[0xE0 | (pcr >> 8) as u8, pcr as u8, 0xF0, 0x00]);
+    for (st, pid) in streams {
+        s.extend_from_slice(&[st, 0xE0 | (pid >> 8) as u8, pid as u8, 0xF0, 0x00]);
+    }
+    psi_packet(out, PID_PMT, &s);
+}
+
+fn put_ts(h: &mut Vec<u8>, prefix: u8, t: i128) {
+    let t = (t.rem_euclid(1 << 33)) as u64;
+    h.push((prefix << 4) | (((t >> 30) & 7) << 1) as u8 | 1);
+    h.push((t >> 22) as u8);
+    h.push((((t >> 15) & 0x7f) << 1) as u8 | 1);
+    h.push((t >> 7) as u8);
+    h.push(((t & 0x7f) << 1) as u8 | 1);
+}
+
+fn pes_header(stream_id: u8, pts: i128, dts: Option<i128>, payload: usize) -> Vec<u8> {
+    let hlen = if dts.is_some() { 10 } else { 5 };
+    let total = 3 + hlen + payload;
+    // Gói hình: độ dài 0 (không giới hạn) như FFmpeg; gói tiếng ghi đúng độ dài
+    let len = if stream_id == 0xE0 || total > 0xFFFF { 0 } else { total };
+    let mut h = vec![0, 0, 1, stream_id, (len >> 8) as u8, len as u8, 0x84, if dts.is_some() { 0xC0 } else { 0x80 }, hlen as u8];
+    match dts {
+        Some(d) => {
+            put_ts(&mut h, 3, pts);
+            put_ts(&mut h, 1, d);
+        }
+        None => put_ts(&mut h, 2, pts),
+    }
+    h
+}
+
+/// Chia một gói PES thành các gói TS 188 byte; gói đầu mang PCR / cờ truy cập ngẫu nhiên nếu có.
+fn ts_packets(out: &mut Vec<u8>, cc: &mut u8, pid: u16, pes: &[u8], pcr: Option<i128>, random_access: bool) {
+    let mut pos = 0usize;
+    let mut first = true;
+    while pos < pes.len() {
+        let mut af: Vec<u8> = Vec::new();
+        if first && (pcr.is_some() || random_access) {
+            let mut flags = 0u8;
+            if random_access {
+                flags |= 0x40;
+            }
+            if pcr.is_some() {
+                flags |= 0x10;
+            }
+            af.push(flags);
+            if let Some(p) = pcr {
+                let b = (p.rem_euclid(1 << 33)) as u64;
+                af.extend_from_slice(&[(b >> 25) as u8, (b >> 17) as u8, (b >> 9) as u8, (b >> 1) as u8, (((b & 1) << 7) as u8) | 0x7E, 0]);
+            }
+        }
+        let remaining = pes.len() - pos;
+        let room = if af.is_empty() { 184 } else { 183 - af.len() };
+        let take = remaining.min(room);
+        if take < room {
+            // Gói cuối: lấp phần trống bằng trường thích ứng
+            let af_total = 184 - take; // gồm cả byte độ dài
+            if af.is_empty() && af_total >= 2 {
+                af.push(0);
+            }
+            while af.len() + 1 < af_total {
+                af.push(0xFF);
+            }
+        }
+        let has_af = !af.is_empty() || take < 184;
+        out.push(0x47);
+        out.push((if first { 0x40 } else { 0 }) | ((pid >> 8) as u8 & 0x1f));
+        out.push(pid as u8);
+        out.push((if has_af { 0x30 } else { 0x10 }) | (*cc & 0x0f));
+        *cc = cc.wrapping_add(1);
+        if has_af {
+            out.push(af.len() as u8);
+            out.extend_from_slice(&af);
+        }
+        out.extend_from_slice(&pes[pos..pos + take]);
+        pos += take;
+        first = false;
+    }
+}
+
+/// Đổi một đoạn fMP4 (moof + mdat, có thể kèm styp / sidx) thành MPEG-TS.
+pub fn remux(init: &Init, seg: &[u8]) -> Res<Vec<u8>> {
+    let seg = unwrap_boxes(seg, &[b"styp", b"sidx", b"moof", b"prft", b"emsg"]);
+    let mut all = samples(init, seg)?;
+    // Mốc 90 kHz: PTS = DTS + cts − media_time của edit list; DTS lùi thêm dts_shift của rãnh. Khoảng lùi = độ lệch âm lớn
+    // nhất gặp được, tối thiểu 2 khung (B-pyramid thường gặp) — để các đoạn sau thường không phải lùi thêm.
+    {
+        let mut shifts = init.dts_shift.lock().unwrap();
+        for ti in 0..init.tracks.len() {
+            let mine = all.iter().filter(|s| s.track == ti);
+            let neg = mine.clone().map(|s| -s.cts).max().unwrap_or(0);
+            if neg > 0 {
+                let two = mine.map(|s| s.dur).next().unwrap_or(0) * 2;
+                let cur = shifts.entry(ti).or_insert(0);
+                *cur = (*cur).max(neg.max(two));
+            }
+        }
+        let mut last: HashMap<usize, i128> = HashMap::new();
+        for s in all.iter_mut() {
+            let tr = &init.tracks[s.track];
+            let sh = shifts.get(&s.track).copied().unwrap_or(0);
+            let p90 = to_90k(s.dts + s.cts - tr.shift as i128, tr.timescale) + OFFSET;
+            let mut d90 = (to_90k(s.dts - tr.shift as i128 - sh, tr.timescale) + OFFSET).min(p90);
+            // DTS không được lùi so với khung trước của cùng rãnh (giữ thứ tự giải mã khi xếp xen kẽ)
+            if let Some(&prev) = last.get(&s.track) {
+                d90 = d90.max(prev);
+            }
+            last.insert(s.track, d90);
+            s.dts = d90;
+            s.pts = p90;
+        }
+    }
+    let is_video = |s: &Sample| matches!(init.tracks[s.track].codec, Codec::Avc { .. });
+    let video = all.iter().any(is_video);
+    let audio = all.iter().any(|s| !is_video(s));
+    // Gói PES: mỗi khung hình một gói; khung tiếng gom từng AUDIO_PER_PES khung liền nhau của cùng rãnh. Xếp theo DTS (giữ
+    // thứ tự gốc khi bằng nhau) để hình và tiếng xen kẽ.
+    let mut units: Vec<(i128, Vec<usize>)> = Vec::new();
+    let mut open: HashMap<usize, usize> = HashMap::new();
+    for (k, s) in all.iter().enumerate() {
+        if is_video(s) {
+            units.push((s.dts, vec![k]));
+            continue;
+        }
+        match open.get(&s.track) {
+            Some(&u) if units[u].1.len() < AUDIO_PER_PES => units[u].1.push(k),
+            _ => {
+                open.insert(s.track, units.len());
+                units.push((s.dts, vec![k]));
+            }
+        }
+    }
+    units.sort_by_key(|u| u.0);
+    let mut out = Vec::with_capacity(seg.len() + seg.len() / 20 + 4096);
+    pat(&mut out);
+    pmt(&mut out, video, audio);
+    let (mut cc_v, mut cc_a) = (0u8, 0u8);
+    let mut buf = Vec::new();
+    for (_, idx) in &units {
+        let s = &all[idx[0]];
+        buf.clear();
+        match &init.tracks[s.track].codec {
+            Codec::Avc { nal_len, sps, pps } => {
+                let key = annex_b(s.data, *nal_len, sps, pps, &mut buf);
+                let dts = (s.dts != s.pts).then_some(s.dts);
+                let mut pes = pes_header(0xE0, s.pts, dts, buf.len());
+                pes.extend_from_slice(&buf);
+                ts_packets(&mut out, &mut cc_v, PID_VIDEO, &pes, Some(s.dts - 9000), key);
+            }
+            Codec::Aac { profile, freq_idx, channels } => {
+                for &k in idx {
+                    let d = all[k].data;
+                    buf.extend_from_slice(&adts_header(*profile, *freq_idx, *channels, d.len()));
+                    buf.extend_from_slice(d);
+                }
+                let mut pes = pes_header(0xC0, s.pts, None, buf.len());
+                pes.extend_from_slice(&buf);
+                let pcr = (!video).then_some(s.pts - 9000);
+                ts_packets(&mut out, &mut cc_a, PID_AUDIO, &pes, pcr, !video);
+            }
+        }
+    }
+    Ok(out)
+}
