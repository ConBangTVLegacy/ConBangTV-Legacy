+    fn full(v: u8, flags: u32, rest: &[u8]) -> Vec<u8> {
+        let mut b = vec![v, (flags >> 16) as u8, (flags >> 8) as u8, flags as u8];
+        b.extend_from_slice(rest);
+        b
+    }
